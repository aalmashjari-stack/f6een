# انسخه إلى .env واملأ القيم من لوحة Supabase.
# الرابط: Integrations ← Data API (أو زرّ Connect).
# المفتاح: Settings ← API Keys ← المفتاح الذي يبدأ بـ sb_publishable_
#
# هذان علنيّان بالتصميم — يُشحنان داخل الحزمة ويراهما أي أحد يفتّشها.
# الحارس هو RLS في supabase/migrations/ لا سرّية المفتاح.
# ولا يُوضع هنا مفتاح sb_secret_ ولا service_role أبداً: يتجاوزان RLS كلّه.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# معرّفا غوغل — للدخول داخل التطبيق الأصليّ (بلا متصفّح).
# من Google Cloud ← APIs & Services ← Credentials:
#   iOS      : نوع «iOS»، وBundle ID = com.f6een.app
#   الويب    : نوع «Web application» — هو نفسه المستعمَل في Supabase
# ويجب تسجيل معرّف iOS في Supabase ← Authentication ← Providers ← Google
# ← Authorized Client IDs، وإلّا رُفض رمزُ الهويّة رغم صحّته.
# علنيّان كمفتاح Supabase: يُشحنان في الحزمة، والحارس تسجيلُهما لا سرّيّتُهما.
VITE_GOOGLE_IOS_CLIENT_ID=
VITE_GOOGLE_WEB_CLIENT_ID=
