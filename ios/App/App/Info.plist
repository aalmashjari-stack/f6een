<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>فطين</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <!-- **لا تحذف UISceneStoryboardFile.** حُذف في ٤ سبتمبر ٢٠٢٦ ظنّاً
                 أنّه يبني نافذةً ثانيةً تلتقطها مرآةُ التلفزيون، وأنّ حذفه
                 آمنٌ لأنّ SceneDelegate يبني نافذته بنفسه. **لم يكن آمناً**:
                 التطبيق فتح على شاشة بيضاء. الـCAPBridgeViewController الذي
                 يبنيه SceneDelegate برمجيّاً لا يحمّل الويب كالذي يبنيه
                 Main.storyboard، فبلا المفتاح لا شيء يُعرض.
                 أُعيد في ٥ سبتمبر ٢٠٢٦. ومشكلة تجمّد الانعكاس ما زالت قائمة
                 وتحتاج مدخلاً آخر. -->
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<!-- أفقيّ فقط. النظام لا يعطي الوضع الطولي أصلاً، فبوابة «أدر جهازك»
	     لا تُستدعى في التطبيق — تبقى في نسخة الويب وحدها حيث لا قفل.
	     الجهتان معاً (يمين ويسار) ليدير اللاعب الجهاز كيف شاء. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- شرطُ قفلِ الاتجاه على الآيباد: تعدّد المهام (Split View) يوجب دعم
	     الاتجاهات كلّها، فمن قصرها على الأفقي وجب أن يخرج منه. -->
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- سكيمُ رجوعِ غوغل: معرّفُ iOS مقلوباً. ورقةُ الدخول تفتح خارج
	     التطبيق لحظةً وتعود عبره، فبلا هذا السطر تفتح ولا ترجع. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.80452444783-f7ag2irbaiqvf04n533c402i6ah0dhhs</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
