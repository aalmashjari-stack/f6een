{
  "name": "f6een",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/clean-icloud-dupes.mjs dist",
    "clean:dupes": "node scripts/clean-icloud-dupes.mjs",
    "start": "node server.js",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync": "npm run build && cap sync && npm run clean:dupes",
    "ios": "npm run build && cap sync ios && npm run clean:dupes && cap open ios",
    "android": "npm run build && cap sync android && npm run clean:dupes && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capgo/capacitor-social-login": "^8.5.0",
    "@supabase/supabase-js": "^2.112.4",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.10"
  }
}
